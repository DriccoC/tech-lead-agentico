# Copie para .env e preencha. NUNCA versione o .env.

# Provedor de LLM: anthropic (padrão) | openai | demo (sem chave, sem custo)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional: modelos por papel e esforço de raciocínio
# ANTHROPIC_MODEL_AGENTE=claude-sonnet-5-5
# ANTHROPIC_MODEL_AUXILIAR=claude-haiku-5-5
# ANTHROPIC_MODEL_JUIZ=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low

# Alternativa OpenAI (LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# LangSmith (observabilidade e avaliação) — smith.langchain.com > Settings > API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tech-lead-agentico

# GitHub: repositório-sandbox para ler e abrir issues (token fine-grained, só Issues: read/write)
GITHUB_REPO=seu-usuario/fabrica-agentica-sandbox
GITHUB_TOKEN=
# Escrita real no GitHub (abrir issues): 1 = ligada; qualquer outro valor = issues simuladas em logs/
GITHUB_ESCRITA_REAL=0

# APIs externas com respostas gravadas (1) ou ao vivo (0). Padrão: offline só no modo demo.
# APIS_OFFLINE=0
