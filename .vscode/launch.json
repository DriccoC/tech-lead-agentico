{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Tech Lead Agêntico",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Testes (modo demonstração)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Avaliação (LangSmith ou local)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/rodar_avaliacao.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
